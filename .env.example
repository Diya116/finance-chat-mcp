# Copy these into your host's environment variables (the code reads os.environ directly).

# ---- backend ----
SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///finance.db                  # production: postgresql+psycopg://user:pass@host/db
BASE_URL=http://127.0.0.1:8001                     # public URL of the backend (OAuth issuer)
MCP_URL=http://127.0.0.1:8000/mcp                  # shown on the website

# ---- mcp server ----
BACKEND_URL=http://127.0.0.1:8001                  # how the MCP server reaches the backend
PUBLIC_BACKEND_URL=http://127.0.0.1:8001           # same as BASE_URL
PUBLIC_MCP_URL=http://127.0.0.1:8000/mcp           # public URL of the MCP endpoint
HOST=127.0.0.1                                     # use 0.0.0.0 when deployed
PORT=8000
